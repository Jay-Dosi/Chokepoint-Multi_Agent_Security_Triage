# Copy to .env and fill in. Everything has a working default except the API key.

# Leave ANTHROPIC_API_KEY empty and the backend runs the scripted agents, which
# still make real MCP tool calls against the live graph.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
AGENT_MODE=live                # live | scripted

FALKORDB_HOST=falkordb
FALKORDB_PORT=6379
GRAPH_NAME=chokepoint

MCP_URL=http://mcp:8765/mcp

EMBEDDINGS=fastembed           # fastembed | none
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

SEED_SCALE=1
OUTBOX_DIR=/data/outbox

# Optional delivery targets for approved actions. Unset means local outbox only.
SLACK_WEBHOOK_URL=
GITHUB_TOKEN=
GITHUB_REPO=

CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173
